{
  "label": "Getting Here Page",
  "blocks": [
    {
      "type": "image-background",
      "fields": {
        "image": { "type": "image", "label": "Hero Image" },
        "image_alt": { "type": "string", "label": "Image Alt Text" },
        "content": { "type": "string", "label": "Hero Content" }
      }
    },
    {
      "type": "section-header",
      "fields": {
        "title": { "type": "string", "label": "Title" },
        "subtitle": { "type": "string", "label": "Subtitle" }
      }
    },
    {
      "type": "markdown",
      "fields": {
        "content": { "type": "string", "label": "Content" }
      }
    },
    {
      "type": "split",
      "fields": {
        "title": { "type": "string", "label": "Title" },
        "content": { "type": "string", "label": "Content" },
        "figure_type": { "type": "string", "label": "Figure Type (image, video, code, html)" },
        "figure_src": { "type": "image", "label": "Figure Image" },
        "figure_alt": { "type": "string", "label": "Figure Alt Text" },
        "figure_caption": { "type": "string", "label": "Figure Caption" },
        "figure_video_id": { "type": "string", "label": "Figure Video ID or URL" },
        "figure_filename": { "type": "string", "label": "Figure Code Filename" },
        "figure_code": { "type": "string", "label": "Figure Code Content" },
        "figure_language": { "type": "string", "label": "Figure Code Language" },
        "figure_html": { "type": "rich-text", "label": "Figure HTML Content" },
        "reverse": { "type": "boolean", "label": "Reverse Layout" }
      }
    },
    {
      "type": "cta",
      "fields": {
        "title": { "type": "string", "label": "Title" },
        "description": { "type": "string", "label": "Description" },
        "button": {
          "type": "object",
          "label": "Button",
          "fields": {
            "text": { "type": "string", "label": "Text" },
            "href": { "type": "string", "label": "URL" }
          }
        }
      }
    }
  ]
}
